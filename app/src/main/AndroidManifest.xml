<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fixes a pre-existing gap found while building Step 15: EmergencyForegroundService
         (Step 11, core-data) has always checked ACCESS_FINE_LOCATION via
         ContextCompat.checkSelfPermission to decide its foreground-service type, but this
         permission was never declared anywhere the real app manifest actually merges from —
         so that check was structurally guaranteed to always see "denied," regardless of what a
         user actually granted. :app does not yet depend on :core-location (Step 15 is scoped to
         that module only), so its own manifest declaration doesn't reach here yet either;
         declaring it directly here is the immediate fix for the app that ships today. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The Emergency Companion's real voice capture (Step 21's AndroidSpeechTranscriber, wired
         at the composition root in MainActivity) needs this to ever succeed —
         VoiceCaptureCoordinator degrades gracefully to a PERMISSION_DENIED failure without it,
         but was previously unable to succeed at all since :app never declared it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Visual design screen 8 ("Oops..."): that screen names why a turn failed, and section 21 lists
         "Internet unavailable" as its own failure row, separate from a Gemini outage. Without this the app
         cannot tell the two apart and would have to guess at the cause — which sections 21/23 forbid. Read
         only: NetworkStatus (core-ai) queries ConnectivityManager, it never opens or changes a connection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Step 52's own finding: the Room database this app ships (LigayaDatabase, core-data)
         stores location history, household/family-member contacts, and emergency event/state
         records — exactly the personal-safety data a Play Store compliance review most scrutinizes
         under Android's default Auto Backup. Beyond privacy, restoring a stale emergency_events/
         emergency_state_snapshot row onto a new or wiped device is a genuine correctness risk for
         a safety-critical app (DefaultEmergencyController treats this database as its own source
         of truth for resuming state) — not just a data-exposure one. Disabled outright rather than
         scoped with dataExtractionRules/fullBackupContent: there's no subset of this database that
         is both non-sensitive and safe to silently reintroduce onto another device. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Ligaya"
        android:theme="@style/Theme.Ligaya">

        <!-- Visual design, screen 1: the launcher entry point carries the splash theme rather than
             the app theme, which is how the system knows what to draw during process start.
             installSplashScreen() in MainActivity.onCreate swaps it to Theme.Ligaya (declared as
             postSplashScreenTheme) once the first frame is ready. -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Ligaya.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
