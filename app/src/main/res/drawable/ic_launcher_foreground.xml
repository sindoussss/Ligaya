<!--
  Adaptive-icon foreground: the Ligaya mark, scaled into the safe zone.

  An adaptive icon's 108x108 canvas only guarantees the centre 72x72 is never masked away (the
  outer ring is reserved for the launcher's own shape/parallax), so the mark is scaled to ~0.6 and
  centred rather than drawn at full bleed — at full size the leaf tips would be cropped by a
  circular launcher mask on most devices.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="60"
        android:scaleX="0.6"
        android:scaleY="0.6">

        <group
            android:pivotX="54"
            android:pivotY="95"
            android:rotation="-52">
            <path
                android:fillColor="#C08787"
                android:pathData="M54,95 Q42.66,72.64 54,45.32 Q65.34,72.64 54,95 Z" />
        </group>

        <group
            android:pivotX="54"
            android:pivotY="95"
            android:rotation="52">
            <path
                android:fillColor="#B97F81"
                android:pathData="M54,95 Q43.2,73.62 54,47.48 Q64.8,73.62 54,95 Z" />
        </group>

        <group
            android:pivotX="54"
            android:pivotY="95"
            android:rotation="-18">
            <path
                android:fillColor="#AE7377"
                android:pathData="M54,95 Q40.5,60.01 54,17.24 Q67.5,60.01 54,95 Z" />
        </group>

        <group
            android:pivotX="54"
            android:pivotY="95"
            android:rotation="18">
            <path
                android:fillColor="#A1646A"
                android:pathData="M54,95 Q41.04,61.95 54,21.56 Q66.96,61.95 54,95 Z" />
        </group>
    </group>
</vector>
