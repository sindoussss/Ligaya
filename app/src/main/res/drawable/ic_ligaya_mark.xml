<!--
  The Ligaya flower mark as a platform vector drawable, for the system splash screen, which the OS
  draws before any Compose code runs. Same petal geometry as LigayaLogo (design-system/LigayaLogo.kt)
  in a 108x108 viewport: five pointed-oval petals rotated about the centre, each axis offset
  sideways a little for the pinwheel. The whole mark is scaled to 0.8 because the splash screen only
  shows the centre circle of its icon; at full size the petal tips would be clipped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:pivotX="54" android:pivotY="54" android:scaleX="0.8" android:scaleY="0.8">
        <group android:pivotX="54" android:pivotY="54" android:rotation="0">
            <path android:pathData="M55.93,55.93 C41.97,38.15 48.23,17.02 55.93,16.27 C63.63,17.02 69.89,38.15 55.93,55.93 Z" android:strokeColor="#8C9A6A57" android:strokeWidth="0.8">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear" android:startX="55.93" android:startY="55.93" android:endX="55.93" android:endY="16.27">
                        <item android:offset="0" android:color="#FFC38E76" />
                        <item android:offset="1" android:color="#FFD5A68D" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
        <group android:pivotX="54" android:pivotY="54" android:rotation="72">
            <path android:pathData="M55.93,55.93 C41.97,38.15 48.23,17.02 55.93,16.27 C63.63,17.02 69.89,38.15 55.93,55.93 Z" android:strokeColor="#8C9A6A57" android:strokeWidth="0.8">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear" android:startX="55.93" android:startY="55.93" android:endX="55.93" android:endY="16.27">
                        <item android:offset="0" android:color="#FFC38E76" />
                        <item android:offset="1" android:color="#FFD5A68D" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
        <group android:pivotX="54" android:pivotY="54" android:rotation="144">
